# One block per product under test. A product's Playwright project activates
# only when its <PRODUCT>_BASE_URL is set.

# --- Example product (copy this block, rename the prefix) ---
# MYPRODUCT_BASE_URL=https://myproduct.example.com
# Test account for authenticated E2E (tests must be read-only: no purchases,
# no settings mutations). Never commit real credentials.
# MYPRODUCT_TEST_EMAIL=qa@example.com
# MYPRODUCT_TEST_PASSWORD=change-me

# --- Freeland ---
FREELAND_BASE_URL=https://freeland.example.com
FREELAND_TEST_EMAIL=qa@example.com
FREELAND_TEST_PASSWORD=change-me

# --- MagicPay ---
MAGICPAY_BASE_URL=https://magicpay.example.com
MAGICPAY_TEST_EMAIL=qa@example.com
MAGICPAY_TEST_PASSWORD=change-me
