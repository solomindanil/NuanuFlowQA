{
  "blueprint_version": "nuanu.universal-qa-flow.blueprint.v1",
  "binding_tokens": [
    "__BINDING_IN_PROGRESS_STATE_ID__",
    "__BINDING_READY_FOR_PRODUCTION_STATE_ID__",
    "__BINDING_QA_AGENT_EMPLOYEE_ID__",
    "__BINDING_QA_AGENT_VERSION_ID__"
  ],
  "graph": {
    "schema_version": 1,
    "name": "Universal QA evidence flow",
    "nodes": [
      {
        "id": "10000000-0000-5000-8000-000000000018",
        "key": "finalize_transition",
        "type": "agent_task",
        "name": "Finalize QA transition",
        "config": {
          "agent_employee_id": "__BINDING_QA_AGENT_EMPLOYEE_ID__",
          "agent_version_id": "__BINDING_QA_AGENT_VERSION_ID__",
          "failure_handling": {
            "mode": "stop"
          },
          "instruction": "Ты выполняешь один stock-compatible Universal QAH canary только из платформенного входа {{input.project_start.artifacts.flow_item}}. Не вызывай get_artifact для входного Flow item или чужих task Artifacts. Создай canonical task-local input с exact source ref, name и media_type. Запусти node scripts/qah/proof-gate-canary.mjs prepare --input <absolute-task-input> --output-dir \"$NUANU_TASK_DIR/qah/proof-gate-canary\". Опубликуй qah-verification.json через publish_artifact_file с output_path item.artifacts.qah_verification, kind document, role output, media_type application/json. Передай actual ref ровно artifact_id, version_id, kind, role в phase=finalize input и запусти тот же CLI с finalize. Опубликуй finalization.json через publish_artifact_file с output_path item.artifacts.finalization_report, kind document, role output, media_type application/json. Передай оба actual ref ровно artifact_id, version_id, kind, role в phase=complete input, запусти CLI с complete и верни только его exact worker 0.3.14 completion. Не создавай Git commit вручную: repository supervisor сам проверяет и публикует текущую task-ветку и заполняет verified_commit. Никаких свободно синтезированных outputs, смены статуса или иных команд.",
          "output": {
            "data": {
              "transition_allowed": {
                "type": "boolean",
                "description": "True only after authoritative comment and cleanup verification"
              },
              "target_state": {
                "type": "string",
                "description": "ready_for_production, in_progress, or ready_for_qa"
              },
              "reason_codes": {
                "type": "json",
                "description": "Closed sorted finalization reason codes"
              },
              "kind": {
                "type": "string",
                "description": "Literal qa admitted by QAH"
              },
              "verdict": {
                "type": "string",
                "description": "pass, fail, or blocked admitted by QAH"
              },
              "tested_head_sha": {
                "type": "string",
                "description": "Exact trusted 40-character repository commit"
              },
              "checks": {
                "type": "json",
                "description": "Closed checks derived from exact verified branch ArtifactVersions"
              }
            },
            "artifacts": {
              "qah_verification": {
                "description": "Exact repository and harness verification receipt",
                "kind": "document",
                "restrictions": {
                  "media_types": [
                    "application/json"
                  ]
                }
              },
              "finalization_report": {
                "description": "Verified final transition gate result",
                "kind": "document",
                "restrictions": {
                  "media_types": [
                    "application/json"
                  ]
                }
              },
              "verified_commit": {
                "description": "Server-verified task branch commit used by the stock Proof Gate",
                "kind": "git.commit"
              }
            }
          }
        }
      },
      {
        "id": "10000000-0000-5000-8000-000000000026",
        "key": "transition_proof_gate",
        "type": "proof_gate",
        "name": "Route final QA state",
        "config": {
          "profile_key": "qa_result_v1",
          "profile_version": "1",
          "ai_assessment": "off"
        }
      },
      {
        "id": "10000000-0000-5000-8000-000000000020",
        "key": "ready_for_production_end",
        "type": "end",
        "name": "Ready for Production",
        "config": {
          "project_status": {
            "target_state_id": "__BINDING_READY_FOR_PRODUCTION_STATE_ID__"
          }
        }
      },
      {
        "id": "10000000-0000-5000-8000-000000000021",
        "key": "in_progress_end",
        "type": "end",
        "name": "Return to In Progress",
        "config": {
          "project_status": {
            "target_state_id": "__BINDING_IN_PROGRESS_STATE_ID__"
          }
        }
      },
      {
        "id": "10000000-0000-5000-8000-000000000022",
        "key": "qa_needs_human_end",
        "type": "end",
        "name": "Keep in Ready for QA",
        "config": {
          "project_status": {
            "target_state_id": null
          }
        }
      }
    ],
    "edges": [
      {
        "id": "20000000-0000-5000-8000-000000000022",
        "source": "10000000-0000-5000-8000-000000000018",
        "target": "10000000-0000-5000-8000-000000000026"
      },
      {
        "id": "20000000-0000-5000-8000-000000000023",
        "source": "10000000-0000-5000-8000-000000000026",
        "target": "10000000-0000-5000-8000-000000000020",
        "name": "passed",
        "when": {
          "outcome": "passed"
        }
      },
      {
        "id": "20000000-0000-5000-8000-000000000024",
        "source": "10000000-0000-5000-8000-000000000026",
        "target": "10000000-0000-5000-8000-000000000021",
        "name": "not_passed",
        "when": {
          "outcome": "not_passed"
        }
      },
      {
        "id": "20000000-0000-5000-8000-000000000025",
        "source": "10000000-0000-5000-8000-000000000026",
        "target": "10000000-0000-5000-8000-000000000022",
        "name": "unable_to_verify",
        "when": {
          "outcome": "unable_to_verify"
        }
      }
    ]
  }
}
