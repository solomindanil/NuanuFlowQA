{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nuanu QA branch result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "branch", "applicability", "product_result"],
  "properties": {
    "schema_version": { "const": "nuanu.qa-branch-result.v1" },
    "branch": { "enum": ["code", "api", "ui", "domain"] },
    "applicability": { "enum": ["REQUIRED", "NOT_APPLICABLE"] },
    "product_result": { "enum": ["PASS", "FAIL", "INCONCLUSIVE", "SKIPPED"] },
    "evidence_status": { "enum": ["VERIFIED", "PARTIAL", "UNVERIFIED"] }
  }
}
